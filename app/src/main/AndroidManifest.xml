<?xml version="1.0" encoding="utf-8"?>

<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- =========================================================
         INTERNET
         ========================================================= -->
    <uses-permission
        android:name="android.permission.INTERNET" />

    <!-- =========================================================
         APK INSTALL PERMISSION
         ========================================================= -->
    <uses-permission
        android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- =========================================================
         ANDROID TV SUPPORT
         TV optional, Mobile-এ বাধ্যতামূলক নয়
         ========================================================= -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />

    <!-- =========================================================
         TOUCHSCREEN OPTIONAL
         Android TV-তে touchscreen বাধ্যতামূলক নয়
         ========================================================= -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/royalcyber_logo"
        android:label="RoyalCyber TV"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/AppTheme">

        <!-- =====================================================
             MOBILE LAUNCHER
             
             Mobile:
             SplashActivity
                  ↓
             MainActivity
             ===================================================== -->
        <activity
            android:name=".SplashActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden"
            android:exported="true">

            <intent-filter>

                <action
                    android:name="android.intent.action.MAIN" />

                <category
                    android:name="android.intent.category.LAUNCHER" />

            </intent-filter>

        </activity>


        <!-- =====================================================
             ANDROID TV LAUNCHER

             TV:
             TvMainActivity
                  ↓
             Channel List
                  ↓
             Channel Select
                  ↓
             TvPlayerActivity
             ===================================================== -->
        <activity
            android:name=".TvMainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden"
            android:screenOrientation="landscape"
            android:exported="true">

            <intent-filter>

                <action
                    android:name="android.intent.action.MAIN" />

                <category
                    android:name="android.intent.category.LEANBACK_LAUNCHER" />

            </intent-filter>

        </activity>


        <!-- =====================================================
             TV PLAYER

             শুধু নির্বাচিত Channel-এর Player
             ===================================================== -->
        <activity
            android:name=".TvPlayerActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden"
            android:screenOrientation="landscape"
            android:exported="false" />


        <!-- =====================================================
             MOBILE MAIN ACTIVITY

             Mobile-এর আগের সম্পূর্ণ MainActivity code
             এখানেই থাকবে।
             ===================================================== -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden"
            android:exported="false" />


        <!-- =====================================================
             UPDATE ACTIVITY
             ===================================================== -->
        <activity
            android:name=".UpdateActivity"
            android:exported="false" />


        <!-- =====================================================
             FILE PROVIDER
             APK Update Install-এর জন্য
             ===================================================== -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">

            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />

        </provider>

    </application>

</manifest>
