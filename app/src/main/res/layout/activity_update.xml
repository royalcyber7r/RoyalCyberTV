<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <ImageView
            android:id="@+id/update_image"
            android:layout_width="match_parent"
            android:layout_height="420dp"
            android:src="@drawable/ic_update_rocket"
            android:scaleType="centerCrop"
            android:contentDescription="Update" />

        <TextView
            android:id="@+id/update_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="New Update is Available"
            android:textColor="#000000"
            android:textSize="31sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:id="@+id/update_version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="38dp"
            android:text="Version 1.0.1 is now available"
            android:textColor="#999999"
            android:textSize="23sp"
            android:gravity="center" />

        <TextView
            android:id="@+id/update_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="35dp"
            android:layout_marginEnd="35dp"
            android:layout_marginTop="48dp"
            android:text="New version is available with important fixes. Please update now to continue watching."
            android:textColor="#999999"
            android:textSize="19sp"
            android:gravity="center"
            android:lineSpacingExtra="8dp" />

        <ProgressBar
            android:id="@+id/update_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:layout_marginStart="28dp"
            android:layout_marginEnd="28dp"
            android:layout_marginTop="55dp"
            android:max="100"
            android:progress="0"
            android:progressTint="#8BC34A"
            android:backgroundTint="#EEEEEE" />

        <TextView
            android:id="@+id/update_percent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-48dp"
            android:text="0 %"
            android:textColor="#FFFFFF"
            android:textSize="24sp" />

        <Button
            android:id="@+id/update_button"
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:layout_marginStart="28dp"
            android:layout_marginEnd="28dp"
            android:layout_marginTop="45dp"
            android:text="Update Now"
            android:textAllCaps="false"
            android:textColor="#8BC34A"
            android:textSize="20sp"
            android:backgroundTint="#FFFFFF" />

        <TextView
            android:id="@+id/update_later"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="30dp"
            android:text="Later"
            android:textColor="#999999"
            android:textSize="17sp"
            android:visibility="visible" />

    </LinearLayout>

</ScrollView>
