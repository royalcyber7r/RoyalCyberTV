<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000">

    <!-- ===================================================== -->
    <!-- MAIN SCROLL AREA -->
    <!-- ===================================================== -->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:background="#000000">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ================================================= -->
            <!-- HEADER -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="8dp"
                android:background="#111111">

                <!-- LOGO -->

                <ImageView
                    android:id="@+id/app_logo"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:src="@android:drawable/sym_def_app_icon"
                    android:scaleType="centerInside"
                    android:contentDescription="RoyalCyber Logo" />

                <!-- BRAND -->

                <TextView
                    android:id="@+id/app_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:text="ROYALCYBERIPTV"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:maxLines="1" />

                <!-- SEARCH BUTTON -->

                <ImageButton
                    android:id="@+id/search_button"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@android:color/transparent"
                    android:src="@android:drawable/ic_menu_search"
                    android:tint="#FFFFFF"
                    android:contentDescription="Search" />

            </LinearLayout>


            <!-- ================================================= -->
            <!-- SEARCH BOX -->
            <!-- ================================================= -->

            <EditText
                android:id="@+id/search_box"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginStart="12dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="12dp"
                android:layout_marginBottom="8dp"
                android:background="#222222"
                android:hint="Search channel..."
                android:textColor="#FFFFFF"
                android:textColorHint="#888888"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:singleLine="true"
                android:inputType="text"
                android:visibility="gone" />


            <!-- ================================================= -->
            <!-- VIDEO PLAYER -->
            <!-- ================================================= -->

            <FrameLayout
                android:id="@+id/player_container"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:background="#000000">

                <androidx.media3.ui.PlayerView
                    android:id="@+id/player_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:keepScreenOn="true"
                    app:use_controller="true"
                    app:show_buffering="when_playing"
                    app:resize_mode="fit" />

            </FrameLayout>


            <!-- ================================================= -->
            <!-- CURRENT CHANNEL NAME -->
            <!-- ================================================= -->

            <TextView
                android:id="@+id/current_channel_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="15dp"
                android:paddingTop="12dp"
                android:paddingEnd="15dp"
                android:paddingBottom="12dp"
                android:text="Live TV"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold"
                android:background="#111111" />


            <!-- ================================================= -->
            <!-- CHANNEL SECTION TITLE -->
            <!-- ================================================= -->

            <TextView
                android:id="@+id/channel_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="15dp"
                android:paddingTop="14dp"
                android:paddingEnd="15dp"
                android:paddingBottom="10dp"
                android:text="Live TV Channels"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />


            <!-- ================================================= -->
            <!-- CHANNEL LIST -->
            <!-- 3 CHANNEL PER ROW -->
            <!-- ================================================= -->

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/channel_recycler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingBottom="10dp"
                android:nestedScrollingEnabled="false"
                android:clipToPadding="false" />


            <!-- ================================================= -->
            <!-- FOOTER -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="25dp"
                android:paddingEnd="20dp"
                android:paddingBottom="25dp"
                android:background="#111111">


                <!-- ROYALCYBER -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ROYALCYBER"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />


                <!-- ABOUT -->

                <TextView
                    android:id="@+id/footer_about"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="About Us"
                    android:textColor="#BBBBBB"
                    android:textSize="14sp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp" />


                <!-- FAQ -->

                <TextView
                    android:id="@+id/footer_faq"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FAQ's"
                    android:textColor="#BBBBBB"
                    android:textSize="14sp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp" />


                <!-- TERMS -->

                <TextView
                    android:id="@+id/footer_terms"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Terms of Use"
                    android:textColor="#BBBBBB"
                    android:textSize="14sp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp" />


                <!-- PRIVACY -->

                <TextView
                    android:id="@+id/footer_privacy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Privacy Policy"
                    android:textColor="#BBBBBB"
                    android:textSize="14sp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp" />


                <!-- ANDROID TV -->

                <TextView
                    android:id="@+id/footer_android_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Get Android TV APK"
                    android:textColor="#BBBBBB"
                    android:textSize="14sp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp" />


                <!-- ================================================= -->
                <!-- AVAILABLE ON -->
                <!-- ================================================= -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:text="Available on"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold" />


                <TextView
                    android:id="@+id/footer_google_play"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Google Play Store"
                    android:textColor="#BBBBBB"
                    android:textSize="14sp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp" />


                <TextView
                    android:id="@+id/footer_apple_store"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Apple App Store"
                    android:textColor="#BBBBBB"
                    android:textSize="14sp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp" />


                <!-- ================================================= -->
                <!-- CALL US -->
                <!-- ================================================= -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:text="Call us"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold" />


                <TextView
                    android:id="@+id/footer_phone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="01611018372"
                    android:textColor="#BBBBBB"
                    android:textSize="14sp" />


                <!-- ================================================= -->
                <!-- FOLLOW US -->
                <!-- ================================================= -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:text="Follow Us"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold" />


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="10dp">

                    <TextView
                        android:id="@+id/footer_facebook"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Facebook"
                        android:textColor="#BBBBBB"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/footer_youtube"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="YouTube"
                        android:textColor="#BBBBBB"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/footer_instagram"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Instagram"
                        android:textColor="#BBBBBB"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/footer_tiktok"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="TikTok"
                        android:textColor="#BBBBBB"
                        android:textSize="13sp" />

                </LinearLayout>


                <!-- ================================================= -->
                <!-- FOOTER LOGO -->
                <!-- ================================================= -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="25dp"
                    android:text="ROYALCYBER"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />


                <!-- COPYRIGHT -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Copyright © 2026 Royalcyber. All rights reserved."
                    android:textColor="#777777"
                    android:textSize="12sp" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>


    <!-- ===================================================== -->
    <!-- PERMANENT BOTTOM MENU -->
    <!-- ===================================================== -->

    <LinearLayout
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#111111"
        android:elevation="8dp">


        <!-- HOME -->

        <LinearLayout
            android:id="@+id/menu_home"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_view"
                android:tint="#FFFFFF"
                android:contentDescription="Home" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Home"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:layout_marginTop="3dp" />

        </LinearLayout>


        <!-- NOTIFICATION -->

        <LinearLayout
            android:id="@+id/menu_notification"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_popup_reminder"
                android:tint="#FFFFFF"
                android:contentDescription="Notification" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Notification"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:layout_marginTop="3dp" />

        </LinearLayout>


        <!-- UPDATE -->

        <LinearLayout
            android:id="@+id/menu_update"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_popup_sync"
                android:tint="#FFFFFF"
                android:contentDescription="Update" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Update"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:layout_marginTop="3dp" />

        </LinearLayout>


        <!-- CHANNEL -->

        <LinearLayout
            android:id="@+id/menu_channel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_media_play"
                android:tint="#FF0000"
                android:contentDescription="Channel" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Channel"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:layout_marginTop="3dp" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
