<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:orientation="vertical"
    android:background="#000000">


    <!-- ========================================================= -->
    <!-- MAIN SCROLL -->
    <!-- ========================================================= -->

    <ScrollView
        android:id="@+id/main_scroll_view"

        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"

        android:fillViewport="true"
        android:background="#000000"

        android:overScrollMode="never">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:orientation="vertical"
            android:background="#000000">


            <!-- ================================================= -->
            <!-- HEADER -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/header_layout"

                android:layout_width="match_parent"
                android:layout_height="70dp"

                android:orientation="horizontal"
                android:gravity="center_vertical"

                android:paddingStart="12dp"
                android:paddingEnd="4dp"

                android:background="#111111">


                <!-- ================================================= -->
                <!-- ROYAL CYBER LOGO -->
                <!-- ================================================= -->

                <ImageView
                    android:id="@+id/app_logo"

                    android:layout_width="48dp"
                    android:layout_height="48dp"

                    android:layout_marginEnd="8dp"

                    android:src="@drawable/royalcyber_logo"

                    android:scaleType="fitCenter"

                    android:contentDescription="RoyalCyberTV Logo" />


                <!-- ================================================= -->
                <!-- APP NAME -->
                <!-- ================================================= -->

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"

                    android:layout_weight="1"

                    android:text="ROYALCYBERIPTV"

                    android:textColor="#FFFFFF"
                    android:textSize="21sp"
                    android:textStyle="bold"

                    android:singleLine="true"

                    android:ellipsize="end" />


                <!-- ================================================= -->
                <!-- SEARCH BUTTON -->
                <!-- ================================================= -->

                <ImageButton
                    android:id="@+id/search_button"

                    android:layout_width="52dp"
                    android:layout_height="52dp"

                    android:background="@android:color/transparent"

                    android:src="@android:drawable/ic_menu_search"
                    android:tint="#FFFFFF"

                    android:padding="10dp"

                    android:contentDescription="Search"

                    android:clickable="true"
                    android:focusable="true" />


            </LinearLayout>


            <!-- ================================================= -->
            <!-- SEARCH BOX -->
            <!-- ================================================= -->

            <EditText
                android:id="@+id/search_box"

                android:layout_width="match_parent"
                android:layout_height="50dp"

                android:layout_marginStart="15dp"
                android:layout_marginEnd="15dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"

                android:paddingStart="15dp"
                android:paddingEnd="15dp"

                android:hint="Search Channel..."

                android:textColor="#FFFFFF"
                android:textColorHint="#888888"

                android:textSize="16sp"

                android:singleLine="true"

                android:background="#222222"

                android:visibility="gone" />


            <!-- ================================================= -->
            <!-- VIDEO PLAYER -->
            <!-- ================================================= -->

            <FrameLayout
                android:id="@+id/player_container"

                android:layout_width="match_parent"
                android:layout_height="220dp"

                android:background="#000000">


                <!-- ================================================= -->
                <!-- EXOPLAYER -->
                <!-- ================================================= -->

                <androidx.media3.ui.PlayerView
                    android:id="@+id/player_view"

                    android:layout_width="match_parent"
                    android:layout_height="match_parent"

                    android:background="#000000"

                    android:keepScreenOn="true"

                    app:use_controller="false"
                    app:show_buffering="when_playing"
                    app:resize_mode="fit" />


                <!-- ================================================= -->
                <!-- CUSTOM PLAYER CONTROLS -->
                <!-- ================================================= -->

                <FrameLayout
                    android:id="@+id/player_controls"

                    android:layout_width="match_parent"
                    android:layout_height="match_parent"

                    android:background="@android:color/transparent"

                    android:clickable="false"
                    android:focusable="false">


                    <!-- ================================================= -->
                    <!-- CENTER CONTROLS -->
                    <!-- ================================================= -->

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:layout_gravity="center"

                        android:orientation="horizontal"
                        android:gravity="center_vertical">


                        <!-- ================================================= -->
                        <!-- REWIND -->
                        <!-- ================================================= -->

                        <TextView
                            android:id="@+id/rewind_button"

                            android:layout_width="65dp"
                            android:layout_height="65dp"

                            android:gravity="center"

                            android:text="↶&#10;10"
                            android:textColor="#FFFFFF"

                            android:textSize="15sp"
                            android:textStyle="bold"

                            android:includeFontPadding="false"

                            android:background="@android:color/transparent"

                            android:clickable="true"
                            android:focusable="true" />


                        <!-- ================================================= -->
                        <!-- PLAY / PAUSE -->
                        <!-- NO BLACK BACKGROUND -->
                        <!-- ================================================= -->

                        <TextView
                            android:id="@+id/play_pause_button"

                            android:layout_width="76dp"
                            android:layout_height="76dp"

                            android:gravity="center"

                            android:text="▶"
                            android:textColor="#FFFFFF"

                            android:textSize="38sp"
                            android:textStyle="normal"

                            android:includeFontPadding="false"

                            android:background="@android:color/transparent"

                            android:clickable="true"
                            android:focusable="true"

                            android:elevation="0dp" />


                        <!-- ================================================= -->
                        <!-- FORWARD -->
                        <!-- ================================================= -->

                        <TextView
                            android:id="@+id/forward_button"

                            android:layout_width="65dp"
                            android:layout_height="65dp"

                            android:gravity="center"

                            android:text="↷&#10;10"
                            android:textColor="#FFFFFF"

                            android:textSize="15sp"
                            android:textStyle="bold"

                            android:includeFontPadding="false"

                            android:background="@android:color/transparent"

                            android:clickable="true"
                            android:focusable="true" />


                    </LinearLayout>


                    <!-- ================================================= -->
                    <!-- LIVE -->
                    <!-- ================================================= -->

                    <TextView
                        android:id="@+id/live_text"

                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:layout_gravity="bottom|start"

                        android:layout_marginStart="18dp"
                        android:layout_marginBottom="17dp"

                        android:text="●  LIVE"

                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />


                    <!-- ================================================= -->
                    <!-- PLAYER PROGRESS LINE -->
                    <!-- ================================================= -->

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="2dp"

                        android:layout_gravity="bottom"

                        android:layout_marginStart="18dp"
                        android:layout_marginEnd="60dp"
                        android:layout_marginBottom="10dp"

                        android:background="#FFFFFF" />


                    <!-- ================================================= -->
                    <!-- FULLSCREEN BUTTON -->
                    <!-- ================================================= -->

                    <ImageButton
                        android:id="@+id/fullscreen_button"

                        android:layout_width="50dp"
                        android:layout_height="50dp"

                        android:layout_gravity="bottom|end"

                        android:layout_marginEnd="4dp"
                        android:layout_marginBottom="2dp"

                        android:background="@android:color/transparent"

                        android:src="@drawable/exo_styled_controls_fullscreen_enter"
                        android:tint="#FFFFFF"

                        android:padding="9dp"

                        android:contentDescription="Fullscreen"

                        android:clickable="true"
                        android:focusable="true"

                        android:elevation="0dp" />


                </FrameLayout>


            </FrameLayout>


            <!-- ================================================= -->
            <!-- CURRENT CHANNEL -->
            <!-- ================================================= -->

            <LinearLayout

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:orientation="vertical"

                android:paddingStart="28dp"
                android:paddingTop="15dp"
                android:paddingEnd="20dp"
                android:paddingBottom="15dp"

                android:background="#111111">


                <TextView
                    android:id="@+id/current_channel_name"

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:text="T Sports"

                    android:textColor="#FFFFFF"
                    android:textSize="23sp"
                    android:textStyle="bold" />


                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:text="Live"

                    android:textColor="#FF2020"
                    android:textSize="16sp"

                    android:layout_marginTop="2dp" />


            </LinearLayout>


            <!-- ================================================= -->
            <!-- CHANNEL TITLE -->
            <!-- ================================================= -->

            <TextView
                android:id="@+id/channel_title"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:paddingStart="28dp"
                android:paddingTop="25dp"
                android:paddingBottom="15dp"

                android:text="Live TV Channels"

                android:textColor="#FFFFFF"
                android:textSize="27sp"
                android:textStyle="bold"

                android:background="#000000" />


            <!-- ================================================= -->
            <!-- CHANNEL GUIDE -->
            <!-- 3 COLUMNS -->
            <!-- ================================================= -->

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/channel_recycler"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingBottom="15dp"

                android:clipToPadding="false"

                android:background="#000000"

                android:overScrollMode="never" />


            <!-- ================================================= -->
            <!-- FOLLOW US -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/footer_layout"

                android:layout_width="match_parent"
                android:layout_height="135dp"

                android:orientation="vertical"

                android:gravity="center"

                android:background="#111111">


                <!-- ================================================= -->
                <!-- FOLLOW US TEXT -->
                <!-- ================================================= -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:text="Follow Us"

                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="normal"

                    android:layout_marginBottom="12dp" />


                <!-- ================================================= -->
                <!-- SOCIAL ICONS -->
                <!-- ================================================= -->

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="45dp"

                    android:orientation="horizontal"
                    android:gravity="center">


                    <!-- ================================================= -->
                    <!-- FACEBOOK -->
                    <!-- ================================================= -->

                    <ImageView
                        android:id="@+id/footer_facebook"

                        android:layout_width="38dp"
                        android:layout_height="38dp"

                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="12dp"

                        android:padding="2dp"

                        android:src="@drawable/ic_facebook"

                        android:contentDescription="Facebook"

                        android:clickable="true"
                        android:focusable="true" />


                    <!-- ================================================= -->
                    <!-- YOUTUBE -->
                    <!-- ================================================= -->

                    <ImageView
                        android:id="@+id/footer_youtube"

                        android:layout_width="40dp"
                        android:layout_height="34dp"

                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="12dp"

                        android:padding="1dp"

                        android:src="@drawable/ic_youtube"

                        android:contentDescription="YouTube"

                        android:clickable="true"
                        android:focusable="true" />


                    <!-- ================================================= -->
                    <!-- INSTAGRAM -->
                    <!-- ================================================= -->

                    <ImageView
                        android:id="@+id/footer_instagram"

                        android:layout_width="38dp"
                        android:layout_height="38dp"

                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="12dp"

                        android:padding="1dp"

                        android:src="@drawable/ic_instagram"

                        android:contentDescription="Instagram"

                        android:clickable="true"
                        android:focusable="true" />


                    <!-- ================================================= -->
                    <!-- TIKTOK -->
                    <!-- ================================================= -->

                    <ImageView
                        android:id="@+id/footer_tiktok"

                        android:layout_width="38dp"
                        android:layout_height="38dp"

                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="12dp"

                        android:padding="2dp"

                        android:src="@drawable/ic_tiktok"

                        android:contentDescription="TikTok"

                        android:clickable="true"
                        android:focusable="true" />


                </LinearLayout>


            </LinearLayout>


        </LinearLayout>


    </ScrollView>


    <!-- ========================================================= -->
    <!-- FIXED BOTTOM NAVIGATION -->
    <!-- ========================================================= -->

    <LinearLayout
        android:id="@+id/bottom_navigation"

        android:layout_width="match_parent"
        android:layout_height="70dp"

        android:orientation="horizontal"

        android:gravity="center"

        android:background="#111111"

        android:elevation="8dp">


        <!-- ================================================= -->
        <!-- HOME -->
        <!-- ================================================= -->

        <LinearLayout
            android:id="@+id/menu_home"

            android:layout_width="0dp"
            android:layout_height="match_parent"

            android:layout_weight="1"

            android:gravity="center"

            android:orientation="vertical"

            android:clickable="true"
            android:focusable="true">


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:text="⌂"

                android:textColor="#FFFFFF"
                android:textSize="27sp" />


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:text="Home"

                android:textColor="#FFFFFF"
                android:textSize="13sp" />


        </LinearLayout>


        <!-- ================================================= -->
        <!-- NOTIFICATION -->
        <!-- ================================================= -->

        <LinearLayout
            android:id="@+id/menu_notification"

            android:layout_width="0dp"
            android:layout_height="match_parent"

            android:layout_weight="1"

            android:gravity="center"

            android:orientation="vertical"

            android:clickable="true"
            android:focusable="true">


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:text="♟"

                android:textColor="#FFFFFF"
                android:textSize="24sp" />


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:text="Notification"

                android:textColor="#FFFFFF"
                android:textSize="13sp" />


        </LinearLayout>


        <!-- ================================================= -->
        <!-- UPDATE -->
        <!-- ================================================= -->

        <LinearLayout
            android:id="@+id/menu_update"

            android:layout_width="0dp"
            android:layout_height="match_parent"

            android:layout_weight="1"

            android:gravity="center"

            android:orientation="vertical"

            android:clickable="true"
            android:focusable="true">


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:text="⟳"

                android:textColor="#FFFFFF"
                android:textSize="27sp" />


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:text="Update"

                android:textColor="#FFFFFF"
                android:textSize="13sp" />


        </LinearLayout>


        <!-- ================================================= -->
        <!-- CHANNEL -->
        <!-- ================================================= -->

        <LinearLayout
            android:id="@+id/menu_channel"

            android:layout_width="0dp"
            android:layout_height="match_parent"

            android:layout_weight="1"

            android:gravity="center"

            android:orientation="vertical"

            android:clickable="true"
            android:focusable="true">


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:text="▶"

                android:textColor="#FFFFFF"
                android:textSize="24sp" />


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:text="Channel"

                android:textColor="#FFFFFF"
                android:textSize="13sp" />


        </LinearLayout>


    </LinearLayout>


</LinearLayout>
