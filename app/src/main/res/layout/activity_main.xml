<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000">

    <!-- ===================================================== -->
    <!-- MAIN CONTENT -->
    <!-- ===================================================== -->

    <ScrollView
        android:id="@+id/main_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:background="#000000"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ================================================= -->
            <!-- HEADER -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/header_layout"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="8dp"
                android:background="#111111">

                <ImageView
                    android:id="@+id/app_logo"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:src="@drawable/royalcyber_logo"
                    android:scaleType="centerInside"
                    android:contentDescription="RoyalCyber Logo" />

                <TextView
                    android:id="@+id/app_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:text="ROYALCYBERIPTV"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:maxLines="1" />

                <ImageButton
                    android:id="@+id/search_button"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@android:color/transparent"
                    android:src="@android:drawable/ic_menu_search"
                    android:tint="#FFFFFF"
                    android:contentDescription="Search" />

            </LinearLayout>


            <!-- ================================================= -->
            <!-- SEARCH -->
            <!-- ================================================= -->

            <EditText
                android:id="@+id/search_box"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginStart="12dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="12dp"
                android:layout_marginBottom="8dp"
                android:background="#222222"
                android:hint="Search channel..."
                android:textColor="#FFFFFF"
                android:textColorHint="#888888"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:singleLine="true"
                android:inputType="text"
                android:visibility="gone" />


            <!-- ================================================= -->
            <!-- PLAYER -->
            <!-- ================================================= -->

            <FrameLayout
                android:id="@+id/player_container"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:background="#000000">

                <androidx.media3.ui.PlayerView
                    android:id="@+id/player_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:keepScreenOn="true"
                    android:background="#000000"
                    app:use_controller="true"
                    app:show_buffering="when_playing"
                    app:resize_mode="fit" />

                <!-- FULLSCREEN ONLY -->
                <!-- Quality button সম্পূর্ণ বাদ দেওয়া হয়েছে -->

                <ImageButton
                    android:id="@+id/fullscreen_button"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="8dp"
                    android:layout_marginBottom="8dp"
                    android:background="#99000000"
                    android:padding="10dp"
                    android:src="@android:drawable/ic_menu_crop"
                    android:tint="#FFFFFF"
                    android:contentDescription="Fullscreen" />

            </FrameLayout>


            <!-- ================================================= -->
            <!-- CURRENT CHANNEL -->
            <!-- ================================================= -->

            <TextView
                android:id="@+id/current_channel_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="15dp"
                android:paddingTop="12dp"
                android:paddingEnd="15dp"
                android:paddingBottom="12dp"
                android:text="Live TV"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold"
                android:background="#111111" />


            <!-- ================================================= -->
            <!-- CHANNEL TITLE -->
            <!-- ================================================= -->

            <TextView
                android:id="@+id/channel_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="15dp"
                android:paddingTop="14dp"
                android:paddingEnd="15dp"
                android:paddingBottom="10dp"
                android:text="Live TV Channels"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />


            <!-- ================================================= -->
            <!-- CHANNEL LIST -->
            <!-- গুরুত্বপূর্ণ:
                 RecyclerView nestedScrolling=false
                 যাতে ScrollView-এর ভিতরে সব item-এর height নেওয়া যায়
            ================================================= -->

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/channel_recycler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="100dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingBottom="15dp"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                android:clipToPadding="false" />


            <!-- ================================================= -->
            <!-- FOOTER -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/footer_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="28dp"
                android:paddingEnd="20dp"
                android:paddingBottom="30dp"
                android:background="#111111">

                <!-- LOGO -->

                <ImageView
                    android:id="@+id/footer_logo"
                    android:layout_width="130dp"
                    android:layout_height="45dp"
                    android:src="@drawable/royalcyber_logo"
                    android:scaleType="fitCenter"
                    android:contentDescription="RoyalCyber" />


                <!-- ABOUT -->

                <TextView
                    android:id="@+id/footer_about"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="About Us"
                    android:textColor="#BBBBBB"
                    android:textSize="14sp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp" />


                <TextView
                    android:id="@+id/footer_faq"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FAQ's"
                    android:textColor="#BBBBBB"
                    android:textSize="14sp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp" />


                <TextView
                    android:id="@+id/footer_terms"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Terms of Use"
                    android:textColor="#BBBBBB"
                    android:textSize="14sp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp" />


                <TextView
                    android:id="@+id/footer_privacy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Privacy Policy"
                    android:textColor="#BBBBBB"
                    android:textSize="14sp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp" />


                <!-- AVAILABLE ON -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:text="Available on"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold" />


                <TextView
                    android:id="@+id/footer_google_play"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Google Play Store"
                    android:textColor="#BBBBBB"
                    android:textSize="14sp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp" />


                <TextView
                    android:id="@+id/footer_apple_store"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Apple App Store"
                    android:textColor="#BBBBBB"
                    android:textSize="14sp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp" />


                <!-- CALL US -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:text="Call us"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold" />


                <TextView
                    android:id="@+id/footer_phone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="01611018372"
                    android:textColor="#BBBBBB"
                    android:textSize="14sp" />


                <!-- ================================================= -->
                <!-- FOLLOW US -->
                <!-- ================================================= -->

                <TextView
                    android:id="@+id/follow_us_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="Follow Us"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold" />


                <!-- SOCIAL ICONS -->

                <LinearLayout
                    android:id="@+id/social_links"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal"
                    android:gravity="start|center_vertical">

                    <!-- FACEBOOK -->

                    <ImageView
                        android:id="@+id/footer_facebook"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginEnd="12dp"
                        android:padding="8dp"
                        android:src="@drawable/ic_facebook"
                        android:scaleType="centerInside"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="Facebook" />


                    <!-- YOUTUBE -->

                    <ImageView
                        android:id="@+id/footer_youtube"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginEnd="12dp"
                        android:padding="8dp"
                        android:src="@drawable/ic_youtube"
                        android:scaleType="centerInside"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="YouTube" />


                    <!-- INSTAGRAM -->

                    <ImageView
                        android:id="@+id/footer_instagram"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginEnd="12dp"
                        android:padding="8dp"
                        android:src="@drawable/ic_instagram"
                        android:scaleType="centerInside"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="Instagram" />


                    <!-- TIKTOK -->

                    <ImageView
                        android:id="@+id/footer_tiktok"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:padding="8dp"
                        android:src="@drawable/ic_tiktok"
                        android:scaleType="centerInside"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="TikTok" />

                </LinearLayout>


                <!-- FOOTER BRAND -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="ROYALCYBER IPTV"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />


                <!-- COPYRIGHT -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Copyright © 2026 Royalcyber. All rights reserved."
                    android:textColor="#777777"
                    android:textSize="12sp" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>


    <!-- ===================================================== -->
    <!-- BOTTOM NAVIGATION -->
    <!-- ===================================================== -->

    <LinearLayout
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#111111"
        android:elevation="8dp">

        <!-- HOME -->

        <LinearLayout
            android:id="@+id/menu_home"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_view"
                android:tint="#FFFFFF"
                android:contentDescription="Home" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Home"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:layout_marginTop="3dp" />

        </LinearLayout>


        <!-- NOTIFICATION -->

        <LinearLayout
            android:id="@+id/menu_notification"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_popup_reminder"
                android:tint="#FFFFFF"
                android:contentDescription="Notification" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Notification"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:layout_marginTop="3dp" />

        </LinearLayout>


        <!-- UPDATE -->

        <LinearLayout
            android:id="@+id/menu_update"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_popup_sync"
                android:tint="#FFFFFF"
                android:contentDescription="Update" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Update"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:layout_marginTop="3dp" />

        </LinearLayout>


        <!-- CHANNEL -->

        <LinearLayout
            android:id="@+id/menu_channel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_media_play"
                android:tint="#FF0000"
                android:contentDescription="Channel" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Channel"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:layout_marginTop="3dp" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
