<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <!-- =====================================================
         TV HEADER
         ===================================================== -->

    <LinearLayout
        android:id="@+id/tv_header"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:background="#000000"
        android:paddingStart="30dp"
        android:paddingEnd="30dp">

        <ImageView
            android:id="@+id/tv_logo"
            android:layout_width="220dp"
            android:layout_height="80dp"
            android:layout_gravity="center"
            android:adjustViewBounds="true"
            android:contentDescription="RoyalCyberTV Logo"
            android:src="@mipmap/ic_launcher"
            android:scaleType="fitCenter" />

    </LinearLayout>


    <!-- =====================================================
         TV MAIN AREA
         ===================================================== -->

    <FrameLayout
        android:id="@+id/tv_content_area"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#000000">

        <!--
            এখন TV test screen খালি থাকবে।
            পরে এখানে Channel / Player যোগ করা যাবে।
        -->

        <TextView
            android:id="@+id/tv_test_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="RoyalCyberTV"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold"
            android:visibility="gone" />

    </FrameLayout>


    <!-- =====================================================
         TV FOOTER
         ===================================================== -->

    <LinearLayout
        android:id="@+id/tv_footer"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:background="#101010">

        <TextView
            android:id="@+id/tv_footer_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RoyalCyberTV"
            android:textColor="#AAAAAA"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center" />

    </LinearLayout>


    <!-- =====================================================
         TV BOTTOM NAVIGATION
         ===================================================== -->

    <LinearLayout
        android:background="@drawable/tv_focus_button"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#151515"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <!-- Home -->

        <TextView
            android:id="@+id/tv_menu_home"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="⌂&#10;Home"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:clickable="true"
            android:background="@drawable/tv_nav_item" />

        <!-- Update -->

        <TextView
            android:id="@+id/menu_update"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="↻&#10;Update"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:clickable="true"
            android:background="@drawable/tv_nav_item" />

    </LinearLayout>

</LinearLayout>
