<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#000000">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:minHeight="650dp"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <!-- RoyalCyber Logo -->

        <ImageView
            android:id="@+id/splash_logo"
            android:layout_width="170dp"
            android:layout_height="170dp"
            android:src="@drawable/royalcyber_logo"
            android:scaleType="fitCenter"
            android:contentDescription="RoyalCyber IPTV Logo" />

        <!-- App Name -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="ROYALCYBER IPTV"
            android:textColor="#FFFFFF"
            android:textSize="25sp"
            android:textStyle="bold"
            android:letterSpacing="0.05" />

        <!-- Subtitle -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="Bangladesh Live TV"
            android:textColor="#BBBBBB"
            android:textSize="14sp" />

        <!-- Developer Text -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Apps Developed By"
            android:textColor="#AAAAAA"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Mamun Hossain Rubel"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Developer Photo -->

        <ImageView
            android:id="@+id/developer_photo"
            android:layout_width="82dp"
            android:layout_height="82dp"
            android:layout_marginTop="12dp"
            android:src="@drawable/developer_photo"
            android:scaleType="centerCrop"
            android:background="@drawable/developer_circle_bg"
            android:clipToOutline="true"
            android:contentDescription="Developer" />

        <!-- Progress -->

        <ProgressBar
            android:id="@+id/splash_progress"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:layout_marginTop="24dp"
            android:indeterminate="true" />

    </LinearLayout>

</ScrollView>
